# ─────────────────────────────────────────────
# 공공데이터포털 (data.go.kr) 인증키
# 서버(API Route)에서만 사용 — 클라이언트에 절대 노출 금지 (NEXT_PUBLIC_ 접두사 사용 금지)
#
# data.go.kr에서 발급하는 "일반 인증키(General Service Key)"는 Encoding/Decoding 두 종류로
# 제공된다. 호출 방식에 따라 필요한 형태가 다르므로 둘 다 보관해 둔다:
#   - ENCODING 키: URL 쿼리스트링에 그대로 이어붙여 호출할 때 사용 (키 자체가 이미
#     URL-encode 되어 있음, 예: fetch 시 직접 문자열 결합)
#   - DECODING 키: URLSearchParams/axios params 등으로 호출해 라이브러리가 자동으로
#     인코딩을 수행하는 경우 사용 (디코딩된 원본 키를 넣어야 이중 인코딩을 피함)
# 엔드포인트/오퍼레이션명은 API별로 다르므로 API마다 ENDPOINT를 별도로 둔다.
# ─────────────────────────────────────────────

# 한국관광공사_기초지자체 중심 관광지 정보 (F1 - areaBasedList1)
# https://www.data.go.kr/data/15128559/openapi.do
TOURAPI_HUB_SPOT_ENDPOINT=https://apis.data.go.kr/B551011/LocgoHubTarService1
TOURAPI_HUB_SPOT_KEY_ENCODED=
TOURAPI_HUB_SPOT_KEY_DECODED=

# 한국관광공사_관광지 집중률 방문자 추이 예측 정보 (F2 - tatsCnctrRatedList)
# https://www.data.go.kr/data/15128555/openapi.do
TOURAPI_CONGESTION_ENDPOINT=https://apis.data.go.kr/B551011/TatsCnctrRateService
TOURAPI_CONGESTION_KEY_ENCODED=
TOURAPI_CONGESTION_KEY_DECODED=

# 한국관광공사_관광지별 연관 관광지 정보 (F3 - areaBasedList1 / searchKeyword1)
# https://www.data.go.kr/data/15128560/openapi.do
TOURAPI_RELATED_SPOT_ENDPOINT=https://apis.data.go.kr/B551011/TarRlteTarService1
TOURAPI_RELATED_SPOT_KEY_ENCODED=
TOURAPI_RELATED_SPOT_KEY_DECODED=

# TourAPI 국문 관광정보서비스 (상세정보/이미지 보강 - detailCommon2, detailImage2)
# https://www.data.go.kr/data/15101578/openapi.do
TOURAPI_DETAIL_ENDPOINT=https://apis.data.go.kr/B551011/KorService2
TOURAPI_DETAIL_KEY_ENCODED=
TOURAPI_DETAIL_KEY_DECODED=

# ─────────────────────────────────────────────
# LLM API (F4 자유 텍스트 파싱, F5 코스 설명 생성)
# 서버사이드에서만 호출 — 키 노출 금지
# ─────────────────────────────────────────────

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# 사용할 Gemini 모델(선택). 미지정 시 `gemini-flash-latest`(현행 안정 flash 별칭)를 사용.
# 고정 버전이 필요하면 예: gemini-3.5-flash
GEMINI_MODEL=

# ─────────────────────────────────────────────
# 카카오맵 SDK (F7 지도 시각화)
# 프론트엔드에서 임베드하므로 NEXT_PUBLIC_ 접두사 필요 (JS 키는 도메인 등록으로 보호)
# https://developers.kakao.com/console/app
# ─────────────────────────────────────────────

NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
